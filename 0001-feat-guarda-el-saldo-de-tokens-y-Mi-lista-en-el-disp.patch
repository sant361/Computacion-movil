index 63e40ed..3993dc0 100644
--- a/pubspec.yaml
+++ b/pubspec.yaml
@@ -11,6 +11,7 @@ dependencies:
     sdk: flutter
   cupertino_icons: ^1.0.6
   video_player: ^2.9.2
+  shared_preferences: ^2.3.2
 
 dev_dependencies:
   flutter_test:
